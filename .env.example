# =============================================================================
#  NL2SQL — configuration. This file is gitignored; .env.example is the template.
# =============================================================================

# --- Cloud zone: the only thing that leaves the machine ----------------------
GROQ_API_KEY=
OPENROUTER_API_KEY=

# The ladder the router climbs, cheapest first. Named provider/model.
#   small   answers most questions, and is the only rung that reports how sure it
#           was — OpenRouter returns log probabilities, Groq refuses them on every
#           model it serves, and that number is what decides whether to climb.
#   medium  free and fast; the usual landing place for a question with a join.
#   large   the rung that has to be right. What `baseline` uses for everything.
MODEL_SMALL=openrouter/openai/gpt-4.1-nano
MODEL_MEDIUM=groq/openai/gpt-oss-20b
MODEL_LARGE=groq/openai/gpt-oss-120b
MODEL_FALLBACK=groq/qwen/qwen3.6-27b

CLOUD_TIMEOUT_S=25
CLOUD_MAX_RETRIES=2

# --- Local zone: writes the answer, and never opens a socket -----------------
LOCAL_GGUF_PATH=models/qwen3-1.7b/Qwen3-1.7B-Q4_K_M.gguf
LOCAL_GGUF_REPO=unsloth/Qwen3-1.7B-GGUF
LOCAL_GGUF_FILE=Qwen3-1.7B-Q4_K_M.gguf
LOCAL_CTX=8192
LOCAL_THREADS=4

# A local folder loads with no network access at all, which is the property the
# report claims; the repo id is the fallback for a clean machine.
GLINER_MODEL=models/gliner2-base-v1
GLINER_FALLBACK=fastino/gliner2-base-v1
GLINER_THRESHOLD=0.45

# --- Data: the published eICU export, used exactly as distributed ------------
DB_PATH=data/eicu.db
INDEX_PATH=data/index.db
SQL_TIMEOUT_S=15
SQL_MAX_ROWS=2000

# --- Privacy -----------------------------------------------------------------
#   demo    the Full Cloud baseline may run, so the benchmark has a column for it
#   strict  what a real deployment sets: the unprotected arm is refused outright
PRIVACY_MODE=demo
TRACE_DIR=traces

# --- Observability ------------------------------------------------------------
# Everything is traced, values included. Legitimate here and only here: eICU is a
# public, de-identified database. Every span still declares its trust zone.
LANGSMITH_TRACING=1
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nl2sql
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Service -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=7860
LOG_LEVEL=INFO
