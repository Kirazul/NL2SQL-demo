# =============================================================================
#  NL2SQL — environment
#  Copy to `.env` and fill in. `.env` is gitignored: never commit it.
#  On Kaggle these go in Add-ons -> Secrets instead.
# =============================================================================

# --- CLOUD ZONE (outside the trust boundary) ---------------------------------
# The SQL generator. The only outbound socket in the system.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Automatic fallback when Groq returns 429 / 5xx / times out.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Failover order, comma separated.
CLOUD_PROVIDER_CHAIN=groq,openrouter
CLOUD_TIMEOUT_S=25
CLOUD_MAX_RETRIES=2

# --- LOCAL ZONE (inside the trust boundary) ----------------------------------
# The answer writer, and the Full Local arm's SQL generator.
#   llamacpp     -> in-process, GGUF on CPU. The default. Genuinely local.
#   ollama       -> a local Ollama server
#   hf-inference -> a network fallback, refused under PRIVACY_MODE=strict
LOCAL_LLM_BACKEND=llamacpp
LOCAL_LLM_GGUF_REPO=unsloth/Qwen3-1.7B-GGUF
LOCAL_LLM_GGUF_FILE=Qwen3-1.7B-Q4_K_M.gguf
# Path to a GGUF already on disk (bash scripts/download_models.sh). When set it
# short-circuits the download, which cannot resume after an interruption — and
# that is unworkable for a 1 GB file.
LOCAL_LLM_GGUF_PATH=models/qwen3-1.7b/Qwen3-1.7B-Q4_K_M.gguf
LOCAL_LLM_CTX=8192
LOCAL_LLM_THREADS=4

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_INFERENCE_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Entity extraction — always in-process, never a network call. A local path is
# preferred over a repository id: the model then loads with no network access at
# all, including on first start.
GLINER_MODEL=models/gliner2-base-v1
GLINER_FALLBACK_MODEL=fastino/gliner2-base-v1
GLINER_THRESHOLD=0.45

# --- DATABASE ----------------------------------------------------------------
DB_PATH=data/warehouse/eicu.db
DB_READONLY=1
SQL_TIMEOUT_S=10
SQL_MAX_ROWS=2000

# --- SECURITY / EGRESS GATE --------------------------------------------------
# strict : refuses every gate bypass, and refuses "local" backends that would
#          reach the network (hf-inference). The program will not start.
# demo   : the Full Cloud baseline may bypass the gate, and every bypass is
#          written to the audit journal.
PRIVACY_MODE=demo
EGRESS_ALLOWLIST_PATH=config/allowlist.yaml
EGRESS_AUDIT_LOG=traces/egress.jsonl

# --- OBSERVABILITY -----------------------------------------------------------
# Everything is traced, values included — eICU is public and de-identified.
# Every run is also written to TRACE_DIR/runs.jsonl, which never leaves the machine.
TRACE_DIR=traces

LANGSMITH_TRACING=0
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nl2sql
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- KAGGLE (publishing the notebooks) ---------------------------------------
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=

# --- THE STABLE LINK ---------------------------------------------------------
# A Kaggle session's tunnel hostname changes every restart, so the notebook
# announces its current address to the Cloudflare Worker and the web page reads
# it back. This token authorises that one POST, and nothing else.
#
# The SAME value has to exist in two places or the announcement is refused with
# a 401 and the interface silently shows no session:
#   1. here, and as a Kaggle secret named PUBLISH_TOKEN — attached to notebook 4
#   2. in the Worker:  cd deploy/worker && wrangler secret put PUBLISH_TOKEN
#
# Any long random string. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
PUBLISH_TOKEN=

# Origins allowed to call the API from a browser. The interface talks to the
# session directly — it is never proxied — so the Worker's origin must be
# allowed. `*` is the default and is right for a public demo on public data.
CORS_ORIGINS=*

# --- APP ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=7860
LOG_LEVEL=INFO
